-- tiny helper — only used to derive dark, neutral UI surfaces from bg,
-- since color8/color0 ("black"/"bright black") aren't guaranteed to
-- actually be dark/neutral (on your last wallpaper bright_black was #AD8400)
local function hex2rgb(hex)
  hex = hex:gsub("#", "")
  return tonumber(hex:sub(1, 2), 16), tonumber(hex:sub(3, 4), 16), tonumber(hex:sub(5, 6), 16)
end
local function rgb2hex(r, g, b)
  return string.format("#%02x%02x%02x",
    math.floor(math.min(255, math.max(0, r))),
    math.floor(math.min(255, math.max(0, g))),
    math.floor(math.min(255, math.max(0, b))))
end
local function lighten(hex, amt)
  local r, g, b = hex2rgb(hex)
  return rgb2hex(r + (255 - r) * amt, g + (255 - g) * amt, b + (255 - b) * amt)
end

